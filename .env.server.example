# Local development settings for the `just` recipes and `compose.yaml`.
# Copy this file to `.env.server` (ignored by Git) and adjust as needed.

CAPSULA_PORT=8500
CAPSULA_MAX_BODY_SIZE=1073741824 # 1 GB
# `dev` disables authentication: every caller is the owner of the `local` org.
CAPSULA_AUTH_MODE=dev

# PostgreSQL (compose service `postgres`)
POSTGRES_USER=capsula
POSTGRES_PASSWORD=capsula_dev
POSTGRES_DB=capsula
POSTGRES_PORT=5432

# S3-compatible object storage (compose service `s3`, a versitygw instance).
# The bucket is created when the service starts. Keep S3_BUCKET and
# CAPSULA_STORAGE_URL in sync.
S3_BUCKET=capsula
S3_PORT=7070

# Storage settings read by capsula-server. `AWS_*` variables are the standard
# AWS SDK credential/endpoint variables; the object_store crate reads them.
# `AWS_ALLOW_HTTP` is only acceptable for local development.
CAPSULA_STORAGE_URL=s3://capsula
AWS_ACCESS_KEY_ID=capsula
AWS_SECRET_ACCESS_KEY=capsula_dev
AWS_ENDPOINT_URL=http://localhost:7070
AWS_REGION=us-east-1
AWS_ALLOW_HTTP=true
