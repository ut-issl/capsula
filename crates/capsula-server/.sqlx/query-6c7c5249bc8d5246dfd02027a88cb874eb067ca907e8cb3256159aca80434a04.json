{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, user_id, kind, ssh_key_id, name, prefix, last_used_at, expires_at,\n               revoked_at, created_at\n        FROM api_tokens\n        WHERE token_hash = $1\n          AND revoked_at IS NULL\n          AND (expires_at IS NULL OR expires_at > NOW())\n        ",
