  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, org_id, created_by, expires_at, max_uses, uses, revoked_at, created_at\n        FROM invitations\n        WHERE code_hash = $1\n          AND revoked_at IS NULL\n          AND expires_at > NOW()\n          AND (max_uses IS NULL OR uses < max_uses)\n        ",
