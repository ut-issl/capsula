{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.slug, u.display_name, u.primary_email, u.accepted_terms_at,\n               u.created_at, m.role, m.created_at AS joined_at\n        FROM memberships m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.org_id = $1\n        ORDER BY (m.role = 'owner') DESC, u.slug\n        ",
