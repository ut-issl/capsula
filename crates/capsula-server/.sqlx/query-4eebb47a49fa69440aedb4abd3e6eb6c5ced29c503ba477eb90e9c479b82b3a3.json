  "query": "\n        SELECT id, org_id, run_id, phase, hook_index, hook_id, output, config,\n               success, error, failure_reason, created_at\n        FROM run_outputs\n        WHERE org_id = $1 AND run_id = $2\n        ORDER BY (phase = 'post'), hook_index\n        ",
