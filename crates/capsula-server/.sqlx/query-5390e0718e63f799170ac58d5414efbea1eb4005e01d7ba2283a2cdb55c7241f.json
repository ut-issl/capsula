{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, name, timestamp, command, vault, project_root,\n                   exit_code, duration_ms, stdout, stderr,\n                   created_at, updated_at\n            FROM runs\n            WHERE vault = $1\n            ORDER BY timestamp DESC\n            LIMIT $2 OFFSET $3\n            ",
