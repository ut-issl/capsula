{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT v.id, v.org_id, v.name, v.created_at, COUNT(r.id) AS \"run_count!\"\n        FROM vaults v\n        LEFT JOIN runs r ON r.org_id = v.org_id AND r.vault_id = v.id\n        WHERE v.org_id = $1 AND v.name = $2\n        GROUP BY v.id\n        ",
