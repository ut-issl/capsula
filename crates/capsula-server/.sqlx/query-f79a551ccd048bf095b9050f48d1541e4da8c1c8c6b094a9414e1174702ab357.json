{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT o.id, o.slug, o.name, o.kind, o.created_at, o.deleted_at, m.role\n        FROM organizations o\n        JOIN memberships m ON m.org_id = o.id\n        WHERE m.user_id = $1 AND o.deleted_at IS NULL\n        ORDER BY o.slug\n        ",
